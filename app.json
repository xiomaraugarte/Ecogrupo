{
  "expo": {
    "name": "Ecogrupo",
    "slug": "Ecogrupo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ecogrupo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#155941",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.ecogrupo",
      "versionCode": 1
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/Ecogrupo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Ecogrupo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F4EF"
        }
      ],
      "expo-font",
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4d39cc08-acf8-4c46-848c-3988524c3ee8"
      }
    }
  }
}